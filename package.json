{
  "name": "docass",
  "private": true,
  "version": "0.3.0",
  "scripts": {
    "postinstall": "node scripts/copy-pdf-assets.mjs",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "dev:host": "dotnet run --project src/host/DocAss.Host -- --dev",
    "build:host": "dotnet build DocAss.sln -c Release",
    "publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish.ps1",
    "format:web": "prettier --write \"src/web/src/**/*.{ts,tsx,css,json}\"",
    "format:host": "dotnet format DocAss.sln",
    "format": "pnpm format:web && pnpm format:host",
    "lint:web": "pnpm --filter web lint",
    "generate:contracts": "node scripts/generate-types.mjs && node scripts/generate-csharp-types.mjs && node scripts/generate-validators.mjs && node scripts/create-contract-fixtures.mjs && node scripts/create-canonical-fixtures.mjs"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "prettier": "^3.10.1"
  }
}
